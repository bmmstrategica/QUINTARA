{
  "name": "quintara",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev:web": "pnpm --filter @quintara/web dev",
    "dev:mobile": "pnpm --filter @quintara/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:api": "pnpm --filter @quintara/api dev",
    "dev:admin": "pnpm --filter @quintara/admin dev",
    "dev:maison": "pnpm --filter @quintara/maison dev",
    "build:store": "bash apps/mobile/scripts/build-store.sh",
    "e2e": "playwright test --trace off",
    "visual": "playwright test --config playwright.visual.config.ts --trace off"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
