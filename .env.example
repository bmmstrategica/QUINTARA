# ─────────────────────────────────────────────────────────────────────────────
# Quintara settings. Copy the parts you need; never commit real values.
# Development needs none of these: every app runs with sample data out of the box.
# ─────────────────────────────────────────────────────────────────────────────

# ── Web app (apps/web/.env.local) ─────────────────────────────────────────────
# Leave empty to run on the in-browser mock. Set it to use the real API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Admin console (apps/admin/.env.local) ────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:4000
# The Maison Quintara shop, linked from the web app and the admin console.
# NEXT_PUBLIC_MAISON_URL=http://localhost:3002

# ── Maison Quintara shop (apps/maison/.env.local) ─────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:4000
# The Quintara web app, for "Your orders", applying and the app link.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Mobile app (apps/mobile/.env for local runs; eas.json sets these for store builds) ──
# Empty: the app runs on its built-in mock. Store builds must use the HTTPS API address.
EXPO_PUBLIC_API_URL=
# Where the membership application opens (the web app).
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# ── API (apps/api/.env or the host's settings) ───────────────────────────────
# production refuses to start with anything missing that it needs.
NODE_ENV=development
# Empty: an in-memory database with sample data (development only). Production: PostgreSQL 15+.
DATABASE_URL=
PORT=4000
HOST=localhost
# The web app, admin console and Maison Quintara addresses, comma-separated: the only origins allowed to call with cookies.
WEB_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Where links in emails point (the web app).
WEB_URL=http://localhost:3000

# Sign-in. code = a one-time code sent by email (required in production). dev = an address alone (development only).
AUTH_MODE=dev
# App store review: one address that signs in with this fixed six-digit code, as reviewers cannot receive email.
# Create the account with `pnpm --filter @quintara/api run first-run` (REVIEW_EMAIL set). Remove after approval if you wish.
REVIEW_EMAIL=
REVIEW_CODE=
# The review account's two-factor step: a second fixed six-digit code, different from REVIEW_CODE. Required with REVIEW_EMAIL in production.
REVIEW_2FA_CODE=

# Two-factor authentication. Production always requires it for every account. In development: required, optional
# (asked only of those who set it up; the default) or off.
TWO_FACTOR=optional
# Encrypts the authenticator secrets. At least 32 random characters, different from CALENDAR_SECRET. Required in
# production. Never change it once in use: everyone would have to set up their authenticator again.
MFA_ENCRYPTION_KEY=

# The admin console: its address (for the email to new staff) and how many accounts can be active at once.
ADMIN_URL=http://localhost:3001
STAFF_SEATS=5
# Behind a load balancer or proxy (Render, Fly.io, AWS): true, or the proxy's address, so limits see real addresses.
TRUST_PROXY=

# Email (sign-in codes and notifications), through Resend. Verify the sending domain with Resend first.
RESEND_API_KEY=
EMAIL_FROM=Quintara <hello@quintaralifestyle.com>

# Encrypts the calendar addresses members connect to QÉRA. At least 32 random characters.
CALENDAR_SECRET=

# QÉRA on WhatsApp (WhatsApp Business Platform, Cloud API). All six, or none.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_NUMBER=
# At least 32 random characters. Keys and encrypts members' WhatsApp numbers. Never change it once in use.
WHATSAPP_NUMBER_SECRET=

# ── First-run setup of a new database (pnpm --filter @quintara/api run first-run) ──
SETUP_ADMIN_EMAIL=
# Their name, as shown in the audit log.
SETUP_ADMIN_NAME=
# Optional; Cape Town, South Africa, Africa/Johannesburg and ZAR unless set.
SETUP_CITY=
SETUP_COUNTRY_CODE=
SETUP_COUNTRY=
SETUP_TIMEZONE=
SETUP_CURRENCY=

# Push notifications to phones, through Expo's push service (Apple and Google behind it; credentials set up with EAS).
# PUSH=off turns push off. In development a stand-in prints what would be sent; PUSH=expo sends for real.
PUSH=
# Optional: the Expo access token, when "enhanced push security" is on in the Expo project.
EXPO_ACCESS_TOKEN=
